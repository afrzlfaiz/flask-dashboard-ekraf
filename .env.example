# Salin menjadi .env. Hanya empat nilai ini yang perlu diperhatikan.
FLASK_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SECRET_KEY=change-me-to-a-random-secret-string

# Sumber seed awal panel Survei Tahunan Ekraf (data runtime disimpan di database).
SURVEY_DATA_PATH=../laporan/Data PKL Fix.xlsx
SURVEY_SHEET_NAME=Sheet6

# Opsional: hanya untuk membuat admin pertama, lalu hapus nilainya.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
