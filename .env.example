# Dashboard Spasial Ekonomi Kreatif Kota Malang — Environment Configuration
# Salin file ini menjadi .env dan sesuaikan nilainya.

# Flask
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-string
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Bootstrap admin hanya saat belum ada admin aktif. Hapus nilainya setelah bootstrap.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Server
HOST=127.0.0.1
PORT=5000
APP_TIMEZONE=Asia/Jakarta

# Database
DATABASE_URL=data/ekraf.db

# CORS — pisahkan dengan koma
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Upload
MAX_UPLOAD_SIZE_MB=10
MAX_UPLOAD_ROWS=5000
MAX_UPLOAD_UNCOMPRESSED_MB=100

# Backup — gunakan volume/lokasi terpisah pada production
BACKUP_DIR=backups
AUTO_BACKUP_ENABLED=true
BACKUP_HOUR=2
BACKUP_RETENTION_DAYS=30

# Logging
LOG_DIR=logs

# Aktifkan hanya bila frontend benar-benar lintas origin dan menggunakan cookie sesi
CORS_SUPPORTS_CREDENTIALS=false
