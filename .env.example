# Salin menjadi .env. Pengaturan lain sudah memakai default dari config.py.

# Flask
FLASK_ENV=development
FLASK_DEBUG=true
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SECRET_KEY=change-me-to-a-random-secret-string

# Bootstrap admin hanya saat belum ada admin aktif. Hapus nilainya setelah bootstrap.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
